include plugin.json mcp.json README.zh-CN.md
include CHANGELOG.md
include .codex-plugin/plugin.json
include .mcp.json
recursive-include scripts *.py
recursive-include skills *.md
include integrations/deepseek-harness/*.md
include integrations/deepseek-harness/*.yml
include integrations/deepseek-harness/*.cjs
include integrations/deepseek-harness/config-bundle/README.md
include integrations/deepseek-harness/config-bundle/cordis.patch.yml
include integrations/deepseek-harness/config-bundle/package.json
include integrations/deepseek-harness/config-bundle/locale/en.json
include integrations/deepseek-harness/config-bundle/locale/zh.json
include integrations/deepseek-harness/config-bundle/icon.svg
include integrations/deepseek-harness/host-plugin/*.cjs
include integrations/deepseek-harness/host-plugin/*.json
include integrations/deepseek-harness/host-plugin/*.yml
include integrations/deepseek-harness/host-plugin/*.md
include integrations/deepseek-harness/host-plugin/locale/*.json
recursive-include docs *.md
recursive-include examples *.md
recursive-include tests *.py
recursive-include benchmarks *.py *.json *.md
global-exclude *.py[cod]
