# Guard against accidentally creating research state in the tool checkout.
/.math-research/
/.math-research-ledger/
/workspace.yaml
.research-migration-*/
/.architecture-audit/
/.research-operator/
/.idea/
/.vscode/
/.claude/
/.codex/
/.agents/

# Credentials and environment-specific configuration.
.env
.env.*
!.env.example
/.local/
.envrc
.pypirc
.streamlit/secrets.toml

# Python environments, generated packages, caches and reports.
.venv*/
env/
venv/
__pycache__/
*.py[codz]
*.egg-info/
*.egg
/build/
/dist/
# Interrupted pip build scratch directories are not project inputs.
/pip-build-tracker-*/
/pip-ephem-wheel-cache-*/
/pip-install-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage*
coverage*
*.xml
coverage.xml
htmlcov/
.local-eval/
*.log

# Frontend installation, build outputs and local tooling caches.
node_modules/
web/dist/
.vite/
*.tsbuildinfo
.DS_Store
Thumbs.db

# Only the small synthetic Episode belongs in the public example surface.
/examples/*
!/examples/demo_research_episode.md
